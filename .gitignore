# pyenv
#   In case you want to ignore your environment:
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, it is recommended not to put Pipfile.lock in version control.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is recommended not to put poetry.lock in version control.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is recommended not to put pdm.lock in version control.
.pdm.toml
.pdm-python
